                          },
                          {
                            "name": "max_length",
                            "type": [
                              "null",
                              "int"
                            ],
                            "default": null,
                            "doc": "The most code points a value has, at least 0 and at least min_length; null for no limit (spec/fields.md, section 4.1)."
                          },
                          {
                            "name": "preferred_length",
                            "type": [
                              "null",
                              "int"
                            ],
                            "default": null,
                            "doc": "The number of code points an input for the field has room for, at least 1 and at most max_length; null for none. Not a limit (spec/fields.md, section 4.1)."
                          },
                          {
                            "name": "placeholder",
