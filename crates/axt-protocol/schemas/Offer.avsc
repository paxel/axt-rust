                            "default": "",
                            "doc": "An example value as text, which meets the field's checks; the empty string for none (spec/fields.md, section 3.4)."
                          }
                        ]
                      },
                      {
                        "type": "record",
                        "name": "EmailField",
                        "doc": "A field of strings that each hold an email address: the format email of spec/metadata.md, section 6.3, built in (spec/fields.md, section 5).",
                        "fields": [
                          {
                            "name": "default",
                            "type": [
                              "null",
                              "string"
                            ],
                            "default": null,
                            "doc": "The value the field starts with when its user gives none, a string of the format email, which meets the field's checks; null for none (spec/fields.md, section 3.3)."
                          },
                          {
                            "name": "min_length",
                            "type": [
                              "null",
                              "int"
                            ],
